datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  role      String   @default("PRODUCER") // ADMIN, PRODUCER
  plan      String   @default("FREE")
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  apps       App[]
  orders     Order[]
  salesPages SalesPage[]
}

model Plan {
  id          String   @id @default(uuid())
  name        String
  price       Float
  interval    String   @default("month") // month, year, lifetime
  maxApps     Int      @default(5)
  features    String?  // JSON string
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model App {
  id         String   @id @default(uuid())
  name       String
  slug       String   @unique
  icon       String?
  blocks     String   @default("[]") // JSON string of canvas blocks
  theme      String   @default("{}") // JSON theme settings
  status     String   @default("DRAFT")
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  salesPages SalesPage[]
  orders     Order[]
}

model SalesPage {
  id          String   @id @default(uuid())
  slug        String   @unique
  title       String
  headline    String?
  description String?
  price       String?
  checkoutUrl String?
  pixelId     String?
  appId       String?
  app         App?     @relation(fields: [appId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Order {
  id            String   @id @default(uuid())
  externalId    String?
  platform      String   @default("KIWIFY") // KIWIFY, HOTMART, EDUZZ, STRIPE, CAKTO, MERCADOPAGO
  customerName  String
  customerEmail String
  customerPhone String?
  amount        Float
  status        String   @default("PAID") // PAID, PENDING, REFUNDED
  appId         String?
  app           App?     @relation(fields: [appId], references: [id], onDelete: SetNull)
  userId        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  payload       String?  // Raw webhook payload JSON
  createdAt     DateTime @default(now())
}

model AISetting {
  id        String   @id @default(uuid())
  provider  String   // openai, gemini, groq, anthropic
  apiKey    String
  isGlobal  Boolean  @default(false)
  userId    String?
  createdAt DateTime @default(now())
}
